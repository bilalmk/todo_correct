# Todo Evolution - Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# PHASE II: MOCK AUTHENTICATION (localStorage-based)
# =============================================================================

# No environment variables required for Phase II demo
# Authentication uses mock data in src/lib/mock-data.ts
# All state persisted to browser localStorage

# Demo Users (hardcoded in src/lib/mock-data.ts):
# - Email: demo@example.com
# - Password: password123

# =============================================================================
# PHASE III: REAL AUTHENTICATION (Better Auth + JWT)
# =============================================================================

# Uncomment and configure these variables when integrating with backend API

# # Next.js Configuration
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:8000

# # Better Auth Configuration
# AUTH_SECRET=your-secret-key-here-minimum-32-characters-long-and-random
# AUTH_URL=http://localhost:3000

# # Backend API Configuration
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/api/v1

# # Better Auth JWKS Configuration (for backend JWT validation)
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# # Session Configuration
# SESSION_MAX_AGE=1800000  # 30 minutes in milliseconds
# SESSION_UPDATE_AGE=300000  # 5 minutes in milliseconds

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================

# # Enable debug logging (optional)
# NEXT_PUBLIC_DEBUG=false

# # Disable analytics in development (optional)
# NEXT_PUBLIC_ANALYTICS_ENABLED=false

# =============================================================================
# PRODUCTION DEPLOYMENT (Vercel)
# =============================================================================

# # Vercel automatically sets these:
# # - VERCEL_URL
# # - VERCEL_ENV (production, preview, development)
# # - NEXT_PUBLIC_VERCEL_URL

# # Production API URL (replace with your deployed backend)
# NEXT_PUBLIC_API_URL=https://api.todoevolution.com

# # Production Auth Secret (generate with: openssl rand -base64 32)
# AUTH_SECRET=<generate-random-secret-for-production>

# =============================================================================
# OPTIONAL: THIRD-PARTY INTEGRATIONS
# =============================================================================

# # Analytics (Phase V - optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# # Error Tracking (Phase V - optional)
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# SENTRY_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# # Feature Flags (Phase V - optional)
# NEXT_PUBLIC_FEATURE_DRAG_DROP=true
# NEXT_PUBLIC_FEATURE_RECURRING_TASKS=true
# NEXT_PUBLIC_FEATURE_REMINDERS=true

# =============================================================================
# NOTES
# =============================================================================

# 1. Environment Variable Prefixes:
#    - NEXT_PUBLIC_* : Exposed to browser (client-side)
#    - No prefix      : Server-side only (API routes, SSR)

# 2. Security:
#    - Never commit .env.local to version control
#    - Add .env.local to .gitignore (already configured)
#    - Rotate AUTH_SECRET regularly in production

# 3. Phase II Demo:
#    - No backend required
#    - All data stored in localStorage
#    - Mock authentication (no real JWT)
#    - No API calls

# 4. Phase III Integration:
#    - Uncomment AUTH_* and NEXT_PUBLIC_API_URL
#    - Configure Better Auth with backend
#    - Use real JWT tokens
#    - Backend API: POST /api/v1/auth/login, /api/v1/auth/register

# 5. Local Development:
#    - Copy this file: cp .env.local.example .env.local
#    - Fill in values for your environment
#    - Restart dev server: npm run dev

# 6. Deployment:
#    - Set environment variables in Vercel dashboard
#    - Configure production secrets via Vercel UI
#    - Never hardcode secrets in codebase
